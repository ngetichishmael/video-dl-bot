BOT_TOKEN=123456789:AAYourTelegramBotTokenHere
# Comma-separated numeric Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=123456789
# Optional: max source download size in MB. Files over ~49MB are re-encoded to fit
# Telegram's 50MB upload limit (originals above 50MB need a local Bot API server).
MAX_FILE_SIZE_MB=100
# Optional: route only these sites through a proxy (e.g. Cloudflare WARP in proxy mode)
# PROXY_URL=socks5://127.0.0.1:40000
# PROXY_HOSTS=reddit.com,redd.it,youtube.com,youtu.be
# Optional: path of the SQLite history file (default: data/hoard.db)
# HISTORY_DB=data/hoard.db
# Optional: timezone for times shown in /history (default Africa/Nairobi)
# TIMEZONE=Africa/Nairobi
